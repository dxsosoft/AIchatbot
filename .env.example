# ==============================================================================
# Database Connection (Read-Only Inspection Module)
# ==============================================================================
PGHOST=localhost
PGPORT=5432
PGDATABASE=ordermgmt_db
PGUSER=postgres
PGPASSWORD=your_secure_password_here

# ==============================================================================
# Type 1: File Upload & AI Knowledge Assistant Configuration
# ==============================================================================
# AI Provider selection: gemini, openai, anthropic, or mock (for testing)
AI_PROVIDER=gemini

# Google Gemini API Key (Required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Model selection
AI_MODEL_NAME=gemini-2.5-flash

# File Upload Settings
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,txt

# Storage paths
UPLOAD_DIR=uploads
DATA_DIR=data
